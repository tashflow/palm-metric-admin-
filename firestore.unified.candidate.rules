rules_version = '2';
service cloud.firestore {
  // ============================================================================
  // PALM METRIC — ISOLATED UNIFIED FIRESTORE SECURITY RULES CANDIDATE
  // PROJECT: palm-metric-app | DATABASE: (default) | SPARK FREE TIER
  // NOTE: ISOLATED AUTHORING ARTIFACT ONLY. DO NOT DEPLOY TO PRODUCTION.
  // ============================================================================
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unconfigured paths
    match /{document=**} {
      allow read, write: if false;
    }

    // ============================================================================
    // PRIMITIVE GLOBAL HELPERS
    // ============================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymousUser() {
      return isSignedIn()
        && (!('firebase' in request.auth.token)
            || !('sign_in_provider' in request.auth.token.firebase)
            || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isVerifiedAdminToken() {
      return isNonAnonymousUser() && (
        request.auth.uid in ['jPgFPc8KbsXaPrdkyrbCQSFDMOP2', '39H76y4E55g5yX2uY0lE5bQ3a393'] ||
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          request.auth.token.email.lower() in [
            'tashflow26@gmail.com',
            'palmmetric1@gmail.com',
            'palmmatric1@gmail.com',
            'tashfilartwork@gmail.com'
          ]
        )
      );
    }

    function isAdmin() {
      return isVerifiedAdminToken() || (
        isNonAnonymousUser()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ============================================================================
    // VALIDATION BLUEPRINTS
    // ============================================================================
    function isValidMenuItem(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'description', 'inStock', 'imageUrl', 'storagePath', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'nameAr', 'category', 'price', 'description', 'descriptionAr', 'inStock', 'isAvailable', 'available', 'outOfStock', 'stockQuantity', 'stockCount', 'imageUrl', 'storagePath', 'allowMilkOption', 'coconutMilkPrice', 'allowTemperature', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('nameAr' in data) || (data.nameAr is string && data.nameAr.size() <= 80))
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.price is number && data.price >= 0 && data.price <= 10000
        && data.description is string && data.description.size() <= 400
        && (!('descriptionAr' in data) || (data.descriptionAr is string && data.descriptionAr.size() <= 400))
        && data.inStock is bool
        && (!('isAvailable' in data) || data.isAvailable is bool)
        && (!('available' in data) || data.available is bool)
        && (!('outOfStock' in data) || data.outOfStock is bool)
        && (!('stockQuantity' in data) || (data.stockQuantity is number && data.stockQuantity >= 0 && data.stockQuantity <= 100000))
        && (!('stockCount' in data) || (data.stockCount is number && data.stockCount >= 0 && data.stockCount <= 100000))
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 2048 && !data.imageUrl.matches('^data:.*')
        && data.storagePath is string && data.storagePath.size() <= 512
        && (!('allowMilkOption' in data) || data.allowMilkOption is bool)
        && (!('coconutMilkPrice' in data) || (data.coconutMilkPrice is number && data.coconutMilkPrice >= 0 && data.coconutMilkPrice <= 500))
        && (!('allowTemperature' in data) || data.allowTemperature is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['key', 'nameEn', 'nameAr', 'sortOrder', 'isActive', 'allowMilkOption', 'allowTemperature', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['key', 'nameEn', 'nameAr', 'sortOrder', 'isActive', 'allowMilkOption', 'allowTemperature', 'createdAt', 'updatedAt'])
        && data.key is string && data.key.size() >= 1 && data.key.size() <= 60
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 60
        && data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 60
        && data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000
        && data.isActive is bool
        && data.allowMilkOption is bool
        && data.allowTemperature is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCoffeeOptions(data) {
      return data.keys().hasAll(['milkSelectionEnabled', 'coconutMilkExtraPrice', 'hotColdSelectionEnabled', 'updatedAt'])
        && data.keys().hasOnly(['milkSelectionEnabled', 'coconutMilkExtraPrice', 'hotColdSelectionEnabled', 'updatedAt'])
        && data.milkSelectionEnabled is bool
        && data.coconutMilkExtraPrice is number && data.coconutMilkExtraPrice >= 0 && data.coconutMilkExtraPrice <= 500
        && data.hotColdSelectionEnabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidPricingSettings(data) {
      return data.keys().hasOnly(['taxEnabled', 'taxRatePercent', 'discountEnabled', 'discountType', 'discountValue', 'discountLabel', 'updatedAt'])
        && (!('taxEnabled' in data) || data.taxEnabled is bool)
        && (!('taxRatePercent' in data) || (data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100))
        && (!('discountEnabled' in data) || data.discountEnabled is bool)
        && (!('discountType' in data) || (data.discountType is string && data.discountType in ['percent', 'fixed']))
        && (!('discountValue' in data) || (data.discountValue is number && data.discountValue >= 0 && data.discountValue <= 10000))
        && (!('discountLabel' in data) || (data.discountLabel is string && data.discountLabel.size() <= 80))
        && data.updatedAt is timestamp;
    }

    function isValidBillboard(data) {
      return data.keys().hasAll(['title', 'mediaType', 'mediaUrl', 'storagePath', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'mediaType', 'mediaUrl', 'storagePath', 'isActive', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.mediaType is string && data.mediaType in ['image', 'video']
        && data.mediaUrl is string && data.mediaUrl.size() >= 1 && data.mediaUrl.size() <= 2048
        && data.storagePath is string && data.storagePath.size() <= 512
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomizationOption(opt) {
      return opt is map
        && opt.keys().hasAll(['id', 'name', 'nameAr', 'additionalPrice', 'enabled', 'isDefault', 'displayOrder'])
        && opt.keys().hasOnly(['id', 'name', 'nameAr', 'additionalPrice', 'enabled', 'isDefault', 'displayOrder'])
        && isValidId(opt.id) && opt.id.size() <= 60
        && opt.name is string && opt.name.size() >= 1 && opt.name.size() <= 80
        && opt.nameAr is string && opt.nameAr.size() >= 1 && opt.nameAr.size() <= 80
        && opt.additionalPrice is number && opt.additionalPrice >= 0 && opt.additionalPrice <= 500
        && opt.enabled is bool
        && opt.isDefault is bool && (!opt.isDefault || opt.enabled)
        && opt.displayOrder is int && opt.displayOrder >= 1 && opt.displayOrder <= 100;
    }

    function areValidCustomizationOptions(opts) {
      return opts is list
        && opts.size() >= 1
        && opts.size() <= 10
        && (opts.size() <= 0 || isValidCustomizationOption(opts[0]))
        && (opts.size() <= 1 || isValidCustomizationOption(opts[1]))
        && (opts.size() <= 2 || isValidCustomizationOption(opts[2]))
        && (opts.size() <= 3 || isValidCustomizationOption(opts[3]))
        && (opts.size() <= 4 || isValidCustomizationOption(opts[4]))
        && (opts.size() <= 5 || isValidCustomizationOption(opts[5]))
        && (opts.size() <= 6 || isValidCustomizationOption(opts[6]))
        && (opts.size() <= 7 || isValidCustomizationOption(opts[7]))
        && (opts.size() <= 8 || isValidCustomizationOption(opts[8]))
        && (opts.size() <= 9 || isValidCustomizationOption(opts[9]));
    }

    function isValidCustomizationGroup(group) {
      return group is map
        && group.keys().hasAll(['id', 'name', 'nameAr', 'type', 'required', 'minSelections', 'maxSelections', 'displayOrder', 'enabled', 'options'])
        && group.keys().hasOnly(['id', 'name', 'nameAr', 'type', 'required', 'minSelections', 'maxSelections', 'displayOrder', 'enabled', 'options'])
        && isValidId(group.id) && group.id.size() <= 60
        && group.name is string && group.name.size() >= 1 && group.name.size() <= 80
        && group.nameAr is string && group.nameAr.size() >= 1 && group.nameAr.size() <= 80
        && group.type is string && group.type in ['single', 'multiple']
        && group.required is bool
        && group.minSelections is int && group.minSelections >= 0 && group.minSelections <= 10
        && group.maxSelections is int && group.maxSelections >= 1 && group.maxSelections <= 10
        && group.minSelections <= group.maxSelections
        && (group.type != 'single' || group.maxSelections == 1)
        && (!group.required || group.minSelections >= 1)
        && group.displayOrder is int && group.displayOrder >= 1 && group.displayOrder <= 100
        && group.enabled is bool
        && areValidCustomizationOptions(group.options);
    }

    function areValidCustomizationGroups(groups) {
      return groups is list
        && groups.size() >= 0
        && groups.size() <= 8
        && (groups.size() <= 0 || isValidCustomizationGroup(groups[0]))
        && (groups.size() <= 1 || isValidCustomizationGroup(groups[1]))
        && (groups.size() <= 2 || isValidCustomizationGroup(groups[2]))
        && (groups.size() <= 3 || isValidCustomizationGroup(groups[3]))
        && (groups.size() <= 4 || isValidCustomizationGroup(groups[4]))
        && (groups.size() <= 5 || isValidCustomizationGroup(groups[5]))
        && (groups.size() <= 6 || isValidCustomizationGroup(groups[6]))
        && (groups.size() <= 7 || isValidCustomizationGroup(groups[7]));
    }

    function isValidProductCustomization(data, productId) {
      return data.keys().hasAll(['productId', 'enabled', 'schemaVersion', 'allowSpecialInstructions', 'updatedBy', 'updatedAt', 'groups'])
        && data.keys().hasOnly(['productId', 'enabled', 'schemaVersion', 'allowSpecialInstructions', 'updatedBy', 'updatedAt', 'groups'])
        && data.productId is string && data.productId == productId
        && data.enabled is bool
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.allowSpecialInstructions is bool
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && areValidCustomizationGroups(data.groups);
    }

    // Order Requests
    function isValidOrderRequestCreate(data, docRequestId) {
      return data.keys().hasAll([
          'requestId', 'requestReference', 'customerUid', 'customerName', 'customerContact',
          'orderType', 'currency', 'items', 'status', 'requestSource',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'requestReference', 'customerUid', 'customerName', 'customerContact',
          'orderType', 'pickupType', 'pickupWindow', 'currency', 'lang', 'orderNote', 'notes', 'items',
          'status', 'reviewStatus', 'requestSource', 'sourceApp', 'clientEstimatedTotal', 'auditTrail',
          'createdAt', 'updatedAt'
        ])
        && data.requestId is string && data.requestId == docRequestId && data.requestId.size() >= 8 && data.requestId.size() <= 128
        && data.requestReference is string && data.requestReference.size() >= 5 && data.requestReference.size() <= 32 && data.requestReference.matches('^REQ-[a-zA-Z0-9_\\-]+$')
        && data.customerUid is string && data.customerUid == request.auth.uid && data.customerUid.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80
        && data.customerContact is string && data.customerContact.size() >= 4 && data.customerContact.size() <= 80
        && data.orderType == 'pickup'
        && data.currency == 'SAR'
        && (!('lang' in data) || data.lang in ['ar', 'en'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && (!('orderNote' in data) || (data.orderNote is string && data.orderNote.size() <= 300))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50
        && data.status == 'pending_review'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isAllowedRequestStatusTransition(prevStatus, nextStatus) {
      return (prevStatus == 'pending_review' && nextStatus in ['reviewing', 'verified', 'rejected', 'order_created'])
        || (prevStatus in ['reviewing', 'under_review', 'in_review'] && nextStatus in ['verified', 'rejected', 'order_created'])
        || (prevStatus == 'verified' && nextStatus in ['rejected', 'order_created']);
    }

    function isValidOrderRequestAdminUpdate(requestId, data, prev) {
      return prev.status in ['pending_review', 'under_review', 'reviewing', 'in_review', 'verified']
        && data.status is string
        && isAllowedRequestStatusTransition(prev.status, data.status)
        && data.customerUid == prev.customerUid
        && data.customerName == prev.customerName
        && data.customerContact == prev.customerContact
        && (!('requestId' in prev) || data.requestId == prev.requestId)
        && (!('requestReference' in prev) || data.requestReference == prev.requestReference)
        && data.items == prev.items
        && data.createdAt == prev.createdAt
        && data.updatedAt == request.time
        && (!('verifiedTotalSar' in data) || (data.verifiedTotalSar is number && data.verifiedTotalSar >= 0 && data.verifiedTotalSar <= 100000))
        && (!('verifiedPricing' in data) || (
          data.verifiedPricing is map
          && data.verifiedPricing.currency == 'SAR'
          && data.verifiedPricing.totalSar is number && data.verifiedPricing.totalSar >= 0 && data.verifiedPricing.totalSar <= 100000
          && (!('totalBillSar' in data.verifiedPricing) || data.verifiedPricing.totalBillSar == data.verifiedPricing.totalSar)
          && (!('verifiedTotalSar' in data) || data.verifiedTotalSar == data.verifiedPricing.totalSar)
        ))
        && (
          data.status != 'rejected' || (
            'rejectionReason' in data && data.rejectionReason is string
            && data.rejectionReason.size() >= 3 && data.rejectionReason.size() <= 300
            && data.rejectedBy == request.auth.uid
            && data.rejectedAt == request.time
            && !('approvedOrderId' in data)
          )
        )
        && (
          data.status != 'order_created' || (
            data.approvedOrderId == 'ord_' + requestId
            && 'approvedOrderNumber' in data && data.approvedOrderNumber is string && data.approvedOrderNumber.size() >= 3 && data.approvedOrderNumber.size() <= 32
            && data.approvedBy == request.auth.uid
            && data.approvedAt == request.time
            && 'verifiedPricing' in data && data.verifiedPricing is map
            && data.verifiedPricing.currency == 'SAR'
            && data.verifiedPricing.totalSar is number && data.verifiedPricing.totalSar >= 0 && data.verifiedPricing.totalSar <= 100000
            && existsAfter(/databases/$(database)/documents/orders/$(data.approvedOrderId))
            && getAfter(/databases/$(database)/documents/orders/$(data.approvedOrderId)).data.sourceRequestId == requestId
            && getAfter(/databases/$(database)/documents/orders/$(data.approvedOrderId)).data.orderNumber == data.approvedOrderNumber
            && getAfter(/databases/$(database)/documents/orders/$(data.approvedOrderId)).data.totalBill == data.verifiedPricing.totalSar
          )
        );
    }

    // Official Orders
    function isValidOrderLineItem(item) {
      return item is map
        && item.keys().hasAll(['itemId', 'name', 'price', 'quantity'])
        && item.itemId is string && item.itemId.size() >= 1 && item.itemId.size() <= 128
        && item.name is string && item.name.size() >= 1 && item.name.size() <= 120
        && item.price is number && item.price >= 0 && item.price <= 100000
        && item.quantity is number && item.quantity >= 1 && item.quantity <= 99;
    }

    function isValidPromotedOrderCreate(orderId, data) {
      return data.keys().hasAll(['orderNumber', 'customerUid', 'customerName', 'customerContact', 'items', 'totalBill', 'status', 'createdAt', 'updatedAt'])
        && data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 && data.orderNumber.matches('^[a-zA-Z0-9_\\-]+$')
        && data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80
        && data.customerContact is string && data.customerContact.size() >= 4 && data.customerContact.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 50 && isValidOrderLineItem(data.items[0])
        && data.totalBill is number && data.totalBill >= 0 && data.totalBill <= 100000
        && (!('currency' in data) || data.currency == 'SAR')
        && (!('orderType' in data) || data.orderType == 'pickup')
        && data.status == 'Pending'
        && data.sourceRequestId is string && isValidId(data.sourceRequestId)
        && orderId == 'ord_' + data.sourceRequestId
        && data.approvedBy == request.auth.uid
        && data.approvedAt == request.time
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/orders/$(orderId))
        && exists(/databases/$(database)/documents/orderRequests/$(data.sourceRequestId))
        && get(/databases/$(database)/documents/orderRequests/$(data.sourceRequestId)).data.status in ['pending_review', 'reviewing', 'under_review', 'in_review', 'verified']
        && get(/databases/$(database)/documents/orderRequests/$(data.sourceRequestId)).data.customerUid == data.customerUid
        && getAfter(/databases/$(database)/documents/orderRequests/$(data.sourceRequestId)).data.status == 'order_created'
        && getAfter(/databases/$(database)/documents/orderRequests/$(data.sourceRequestId)).data.approvedOrderId == orderId
        && existsAfter(/databases/$(database)/documents/orderNumbers/$(data.orderNumber))
        && getAfter(/databases/$(database)/documents/orderNumbers/$(data.orderNumber)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/orderNumbers/$(data.orderNumber)).data.requestId == data.sourceRequestId;
    }

    function isValidOrderNumberClaim(data, orderNum) {
      return data.keys().hasAll(['orderNumber', 'orderId', 'requestId', 'customerUid', 'createdAt'])
        && data.orderNumber is string && data.orderNumber == orderNum && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32
        && data.orderId is string && isValidId(data.orderId)
        && data.requestId is string && isValidId(data.requestId)
        && data.customerUid is string && data.customerUid.size() >= 1 && data.customerUid.size() <= 128
        && data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(data.orderId))
        && getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data.orderNumber == orderNum
        && getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data.sourceRequestId == data.requestId;
    }

    function isValidOrderUpdate(data) {
      return data.orderNumber == existing().orderNumber
        && data.customerUid == existing().customerUid
        && data.customerName == existing().customerName
        && data.customerContact == existing().customerContact
        && data.items == existing().items
        && data.totalBill == existing().totalBill
        && data.createdAt == existing().createdAt
        && data.status is string && data.status in ['Pending', 'Preparing', 'Ready', 'Completed', 'Cancelled']
        && data.updatedAt == request.time;
    }

    function isValidOrderRequestAuditLog(data) {
      return data.keys().hasAll(['requestId', 'action', 'createdAt'])
        && data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128
        && data.action in [
          'start_review', 'verify', 'verify_request', 'price_verified', 'price_verification',
          'approve', 'approve_and_promote', 'order_promoted', 'order_promotion',
          'reject', 'reject_request', 'duplicate_approval_blocked', 'verification_blocked', 'submitted'
        ]
        && (
          ('adminUid' in data && data.adminUid is string && data.adminUid == request.auth.uid) ||
          ('actorUid' in data && data.actorUid is string && data.actorUid == request.auth.uid)
        )
        && data.createdAt == request.time;
    }

    function isValidReportCreate(data) {
      return data.keys().hasAll(['type', 'title', 'status', 'createdAt'])
        && data.type in ['order', 'feedback', 'customer_signup', 'issue']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.status == 'New'
        && data.createdAt == request.time;
    }

    function isValidReportUpdate(data) {
      return data.keys().hasAll(['type', 'title', 'status', 'createdAt'])
        && data.type == existing().type
        && data.title == existing().title
        && data.createdAt == existing().createdAt
        && data.status in ['New', 'Reviewed', 'Resolved'];
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll(['uid', 'token', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.token is string && data.token.size() >= 10 && data.token.size() <= 4096;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll(['mimeType', 'totalBytes', 'chunkCount', 'isPublic', 'createdBy', 'createdAt'])
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 100
        && data.totalBytes is int && data.totalBytes > 0 && data.totalBytes <= 16777216
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 40
        && data.isPublic is bool
        && data.createdBy is string && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidMediaChunk(data) {
      return data.keys().hasAll(['index', 'data', 'createdAt'])
        && data.index is int && data.index >= 0 && data.index < 40
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 800000
        && data.createdAt is timestamp;
    }

    // ============================================================================
    // COLLECTION RULES MATCH BLOCKS (16 PATHS)
    // ============================================================================

    // 1. /menu/{itemId}
    match /menu/{itemId} {
      allow get: if isValidId(itemId) && (isAdmin() || ('inStock' in existing() && existing().inStock == true));
      allow list: if isVerifiedAdminToken() || ('inStock' in resource.data && resource.data.inStock == true);
      allow create, update: if isValidId(itemId) && isAdmin() && isValidMenuItem(incoming());
      allow delete: if isValidId(itemId) && isAdmin();
    }

    // 2. /categories/{categoryId}
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (isAdmin() || ('isActive' in existing() && existing().isActive == true));
      allow list: if isVerifiedAdminToken() || ('isActive' in resource.data && resource.data.isActive == true);
      allow create, update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().createdAt == request.time;
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    // 3. /settings/{settingId}
    match /settings/{settingId} {
      allow get: if settingId == 'coffeeOptions' || isAdmin();
      allow list: if isVerifiedAdminToken();
      allow create, update: if isAdmin() && (
        (settingId == 'coffeeOptions' && isValidCoffeeOptions(incoming())) ||
        (settingId == 'pricing' && isValidPricingSettings(incoming()))
      );
      allow delete: if false;
    }

    // 4. /billboards/{billboardId}
    match /billboards/{billboardId} {
      allow get: if isValidId(billboardId) && (isAdmin() || ('isActive' in existing() && existing().isActive == true));
      allow list: if isVerifiedAdminToken() || ('isActive' in resource.data && resource.data.isActive == true);
      allow create, update: if isValidId(billboardId) && isAdmin() && isValidBillboard(incoming());
      allow delete: if isValidId(billboardId) && isAdmin();
    }

    // 5. /productCustomizations/{productId}
    match /productCustomizations/{productId} {
      allow get: if isValidId(productId) && (isAdmin() || ('enabled' in existing() && existing().enabled == true));
      allow list: if isVerifiedAdminToken() || ('enabled' in resource.data && resource.data.enabled == true);
      allow create, update: if isValidId(productId) && isAdmin() && isValidProductCustomization(incoming(), productId);
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 6. /orderRequests/{requestId}
    match /orderRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn() && (
        isAdmin() || ('customerUid' in existing() && existing().customerUid == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isVerifiedAdminToken() || ('customerUid' in resource.data && resource.data.customerUid == request.auth.uid)
      );
      allow create: if isValidId(requestId) && isSignedIn() && isValidOrderRequestCreate(incoming(), requestId);
      allow update: if isValidId(requestId) && isAdmin() && isValidOrderRequestAdminUpdate(requestId, incoming(), existing());
      allow delete: if false;

      // 7. /orderRequests/{requestId}/auditLogs/{logId}
      match /auditLogs/{logId} {
        allow get, list: if isValidId(requestId) && isAdmin();
        allow create: if isValidId(requestId) && isValidId(logId) && isAdmin() && incoming().requestId == requestId && isValidOrderRequestAuditLog(incoming());
        allow update, delete: if false;
      }
    }

    // 8. /orderRequestAuditLogs/{auditId}
    match /orderRequestAuditLogs/{auditId} {
      allow get: if isValidId(auditId) && isAdmin();
      allow list: if isVerifiedAdminToken();
      allow create: if isValidId(auditId) && isAdmin() && isValidOrderRequestAuditLog(incoming());
      allow update, delete: if false;
    }

    // 9. /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (
        isAdmin() || ('customerUid' in existing() && existing().customerUid == request.auth.uid)
      );
      allow list: if isSignedIn() && (
        isVerifiedAdminToken() || ('customerUid' in resource.data && resource.data.customerUid == request.auth.uid)
      );
      allow create: if isValidId(orderId) && isAdmin() && isValidPromotedOrderCreate(orderId, incoming());
      allow update: if isValidId(orderId) && isAdmin() && isValidOrderUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 10. /orderNumbers/{orderNumber}
    match /orderNumbers/{orderNumber} {
      allow get: if isValidId(orderNumber) && isAdmin();
      allow list: if isVerifiedAdminToken();
      allow create: if isValidId(orderNumber) && isAdmin() && isValidOrderNumberClaim(incoming(), orderNumber);
      allow update, delete: if false;
    }

    // 11. /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isVerifiedAdminToken();
      allow create, update, delete: if false;
    }

    // 12. /mediaAssets/{assetId}
    match /mediaAssets/{assetId} {
      allow get: if isValidId(assetId) && (isAdmin() || ('isPublic' in existing() && existing().isPublic == true));
      allow list: if isVerifiedAdminToken() || ('isPublic' in resource.data && resource.data.isPublic == true);
      allow create: if isValidId(assetId) && isAdmin() && isValidMediaAsset(incoming());
      allow update: if false;
      allow delete: if isValidId(assetId) && isAdmin();

      // 13. /mediaAssets/{assetId}/chunks/{chunkId}
      match /chunks/{chunkId} {
        allow get: if isValidId(assetId) && isValidId(chunkId) && (
          get(/databases/$(database)/documents/mediaAssets/$(assetId)).data.isPublic == true || isAdmin()
        );
        allow list: if false;
        allow create: if isValidId(assetId) && isValidId(chunkId) && isAdmin() && exists(/databases/$(database)/documents/mediaAssets/$(assetId)) && isValidMediaChunk(incoming());
        allow update: if false;
        allow delete: if isValidId(assetId) && isValidId(chunkId) && isAdmin();
      }
    }

    // 14. /reports/{reportId}
    match /reports/{reportId} {
      allow create: if isValidId(reportId) && isSignedIn() && isValidReportCreate(incoming());
      allow get: if isValidId(reportId) && isAdmin();
      allow list: if isVerifiedAdminToken();
      allow update: if isValidId(reportId) && isAdmin() && isValidReportUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isValidId(reportId) && isAdmin();
    }

    // 15. /fcmTokens/{tokenId}
    match /fcmTokens/{tokenId} {
      allow get: if isSignedIn() && (isAdmin() || ('uid' in existing() && existing().uid == request.auth.uid));
      allow list: if isSignedIn() && (isVerifiedAdminToken() || ('uid' in resource.data && resource.data.uid == request.auth.uid));
      allow create, update: if isSignedIn() && isValidFcmToken(incoming()) && existing().uid == request.auth.uid;
      allow delete: if isSignedIn() && (isAdmin() || existing().uid == request.auth.uid);
    }

    // 16. /idempotencyKeys/{keyId}
    match /idempotencyKeys/{keyId} {
      allow read, write: if false;
    }
  }
}
