{
  "entities": {
    "MenuItem": {
      "title": "MenuItem",
      "description": "A specialty coffee, matcha, cold drink, dessert, or food item on the menu.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name of the menu item."
        },
        "nameAr": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional Arabic display name of the menu item."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Dynamic menu category key managed via /categories."
        },
        "price": {
          "type": "number",
          "description": "Unit price in SAR (﷼)."
        },
        "description": {
          "type": "string",
          "maxLength": 400,
          "description": "Short tasting notes or ingredient description."
        },
        "descriptionAr": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional Arabic description of the menu item."
        },
        "inStock": {
          "type": "boolean",
          "description": "Whether the item is currently available for customer ordering."
        },
        "stockQuantity": {
          "type": "number",
          "description": "Optional managed stock quantity decremented atomically on order approval."
        },
        "stockCount": {
          "type": "number",
          "description": "Optional alias stock counter decremented atomically when present."
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 2048,
          "description": "Firebase Storage download URL for the item photograph."
        },
        "storagePath": {
          "type": "string",
          "maxLength": 512,
          "description": "Firebase Storage object path for managing replacements and deletions."
        },
        "allowMilkOption": {
          "type": "boolean",
          "description": "Optional per-item override for enabling Regular/Coconut milk selection."
        },
        "coconutMilkPrice": {
          "type": "number",
          "description": "Optional per-item override for coconut milk extra charge in SAR."
        },
        "allowTemperature": {
          "type": "boolean",
          "description": "Optional per-item override for enabling Hot/Cold temperature selection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "name",
        "category",
        "price",
        "description",
        "inStock",
        "imageUrl",
        "storagePath",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Admin-managed menu category with bilingual labels and default drink customization behavior.",
      "type": "object",
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 60 },
        "nameEn": { "type": "string", "minLength": 1, "maxLength": 60 },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 60 },
        "sortOrder": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "allowMilkOption": { "type": "boolean" },
        "allowTemperature": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "nameEn", "nameAr", "sortOrder", "isActive", "allowMilkOption", "allowTemperature", "createdAt", "updatedAt"]
    },
    "CoffeeOptionsSettings": {
      "title": "CoffeeOptionsSettings",
      "description": "Store-wide coffee modifier configuration synced between Admin App and Customer Order App.",
      "type": "object",
      "properties": {
        "milkSelectionEnabled": { "type": "boolean" },
        "coconutMilkExtraPrice": { "type": "number" },
        "hotColdSelectionEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["milkSelectionEnabled", "coconutMilkExtraPrice", "hotColdSelectionEnabled", "updatedAt"]
    },
    "BillboardAd": {
      "title": "BillboardAd",
      "description": "A promotional image poster or video asset displayed on the Customer App billboard slider.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Offer headline displayed on the billboard."
        },
        "mediaType": {
          "type": "string",
          "enum": ["image", "video"],
          "description": "Type of promotional media uploaded to Firebase Storage."
        },
        "mediaUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Firebase Storage download URL for the poster image or promotional video."
        },
        "storagePath": {
          "type": "string",
          "maxLength": 512,
          "description": "Firebase Storage object path."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the offer is live on the customer storefront billboard."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "title",
        "mediaType",
        "mediaUrl",
        "storagePath",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "A live customer order synced between the Customer App and Admin Live Orders Dashboard.",
      "type": "object",
      "properties": {
        "orderNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Human-readable order identifier."
        },
        "customerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Authenticated user UID who placed the order."
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Customer display name."
        },
        "customerContact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Table number or phone contact."
        },
        "items": {
          "type": "array",
          "description": "Line items with itemId, name, price, and quantity."
        },
        "subtotal": {
          "type": "number",
          "description": "Verified subtotal in SAR before configured discounts and taxes."
        },
        "discountTotal": {
          "type": "number",
          "description": "Verified configured discount amount in SAR."
        },
        "taxTotal": {
          "type": "number",
          "description": "Verified configured tax amount in SAR."
        },
        "totalBill": {
          "type": "number",
          "description": "Authoritative total order bill in SAR."
        },
        "currency": {
          "type": "string",
          "enum": ["SAR"],
          "description": "Order currency."
        },
        "orderType": {
          "type": "string",
          "enum": ["pickup"],
          "description": "Pickup-only fulfillment type."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["pay_on_pickup"],
          "description": "Pickup payment method."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "pending", "paid", "pay_at_pickup"],
          "description": "Payment state for the pickup order."
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Preparing", "Ready", "Completed", "Cancelled"],
          "description": "Current fulfillment status."
        },
        "notes": {
          "type": "string",
          "maxLength": 240,
          "description": "Optional preparation notes."
        },
        "sourceRequestId": {
          "type": "string",
          "maxLength": 128,
          "description": "Canonical originating /orderRequests document ID when promoted by Admin."
        },
        "requestReference": {
          "type": "string",
          "maxLength": 32,
          "description": "Customer-facing REQ-... reference preserved from Stage 04K/04L."
        },
        "approvedBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Authenticated Admin UID who approved promotion."
        },
        "approvedByEmail": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of approving Admin."
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of Admin approval and promotion."
        },
        "pricingVersion": {
          "type": "integer",
          "description": "Authoritative pricing engine version."
        },
        "sourceApp": {
          "type": "string",
          "maxLength": 64,
          "description": "Source application identifier."
        },
        "idempotencyKey": {
          "type": "string",
          "maxLength": 128,
          "description": "Idempotency key preventing duplicate official order creation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-modified timestamp."
        }
      },
      "required": [
        "orderNumber",
        "customerUid",
        "customerName",
        "customerContact",
        "items",
        "totalBill",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin record granting management privileges.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Admin email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 80,
          "description": "Admin display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["email", "displayName", "createdAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Metadata and inline payload for uploaded images or chunked videos stored in Firestore when Firebase Storage is unavailable on Starter Tier.",
      "type": "object",
      "properties": {
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "MIME type of the uploaded image or video."
        },
        "totalBytes": {
          "type": "integer",
          "description": "Total byte size of the stored asset."
        },
        "chunkCount": {
          "type": "integer",
          "description": "Number of chunks in /chunks subcollection (0 when stored in inlineData)."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Whether storefront visitors may read this asset."
        },
        "inlineData": {
          "type": "string",
          "maxLength": 800000,
          "description": "Base64 payload for compact media assets under 650 KB."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "description": "Admin UID who uploaded the asset."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["mimeType", "totalBytes", "chunkCount", "isPublic", "createdBy", "createdAt"]
    },
    "MediaChunk": {
      "title": "MediaChunk",
      "description": "Sequential base64 chunk for larger uploaded media assets such as promotional videos.",
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "description": "Zero-based chunk order index."
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800000,
          "description": "Base64-encoded chunk slice."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": ["index", "data", "createdAt"]
    },
    "CustomizationOption": {
      "title": "CustomizationOption",
      "description": "An individual bilingual choice inside a product customization group with optional SAR surcharge.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 80 },
        "additionalPrice": { "type": "number" },
        "enabled": { "type": "boolean" },
        "isDefault": { "type": "boolean" },
        "displayOrder": { "type": "integer" }
      },
      "required": ["id", "name", "nameAr", "additionalPrice", "enabled", "isDefault", "displayOrder"]
    },
    "CustomizationGroup": {
      "title": "CustomizationGroup",
      "description": "A single-choice or multiple-choice selection group with min/max bounds.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 60 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "nameAr": { "type": "string", "minLength": 1, "maxLength": 80 },
        "type": { "type": "string", "enum": ["single", "multiple"] },
        "required": { "type": "boolean" },
        "minSelections": { "type": "integer" },
        "maxSelections": { "type": "integer" },
        "displayOrder": { "type": "integer" },
        "enabled": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": { "$ref": "#/entities/CustomizationOption" }
        }
      },
      "required": ["id", "name", "nameAr", "type", "required", "minSelections", "maxSelections", "displayOrder", "enabled", "options"]
    },
    "ProductCustomization": {
      "title": "ProductCustomization",
      "description": "Admin-controlled per-product customization configuration consumed in real time by the Customer App.",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "enabled": { "type": "boolean" },
        "schemaVersion": { "type": "integer" },
        "allowSpecialInstructions": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/entities/CustomizationGroup" }
        }
      },
      "required": ["productId", "enabled", "schemaVersion", "allowSpecialInstructions", "updatedBy", "updatedAt", "groups"]
    },
    "OrderRequest": {
      "title": "OrderRequest",
      "description": "Stage 04K/04L customer order request queued for Admin verification, authoritative SAR pricing, and atomic promotion to /orders.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requestReference": { "type": "string", "minLength": 5, "maxLength": 32 },
        "customerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "customerContact": { "type": "string", "minLength": 1, "maxLength": 80 },
        "orderType": { "type": "string", "enum": ["pickup"] },
        "pickupType": { "type": "string", "enum": ["pickup"] },
        "pickupWindow": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "enum": ["SAR"] },
        "items": { "type": "array", "description": "Requested menu items, quantities, and option IDs." },
        "notes": { "type": "string", "maxLength": 300 },
        "orderNote": { "type": "string", "maxLength": 300 },
        "status": {
          "type": "string",
          "enum": ["pending_review", "reviewing", "verified", "rejected", "order_created"]
        },
        "reviewStatus": {
          "type": "string",
          "enum": ["unreviewed", "in_review", "verified", "needs_attention", "approved", "rejected"]
        },
        "requestSource": { "type": "string", "maxLength": 64 },
        "sourceApp": { "type": "string", "maxLength": 64 },
        "clientEstimatedTotal": { "type": "number" },
        "verifiedTotalSar": { "type": "number" },
        "verifiedPricing": { "type": "object" },
        "verifiedItems": { "type": "array" },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "approvedOrderId": { "type": "string", "maxLength": 128 },
        "approvedOrderNumber": { "type": "string", "maxLength": 32 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "rejectedBy": { "type": "string", "maxLength": 128 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "auditTrail": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "requestReference",
        "customerUid",
        "customerName",
        "customerContact",
        "pickupType",
        "items",
        "status",
        "reviewStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderNumberClaim": {
      "title": "OrderNumberClaim",
      "description": "Immutable registry guaranteeing unique official PM-XXXXXX order numbers across concurrent approvals.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 32 },
        "orderId": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 128 },
        "customerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "orderId", "requestId", "customerUid", "createdAt"]
    },
    "OrderRequestAuditLog": {
      "title": "OrderRequestAuditLog",
      "description": "Append-only Admin audit trail record for order request review, price verification, approval/promotion, and rejection.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "maxLength": 128 },
        "requestReference": { "type": "string", "maxLength": 32 },
        "action": {
          "type": "string",
          "enum": ["submitted", "start_review", "verify", "price_verified", "approve", "order_promoted", "reject"]
        },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "actorRole": { "type": "string", "enum": ["admin", "customer", "system"] },
        "fromStatus": { "type": "string" },
        "toStatus": { "type": "string" },
        "note": { "type": "string", "maxLength": 240 },
        "rejectionReason": { "type": "string", "maxLength": 300 },
        "approvedOrderId": { "type": "string", "maxLength": 128 },
        "approvedOrderNumber": { "type": "string", "maxLength": 32 },
        "verifiedTotalSar": { "type": "number" },
        "createdAtIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "requestReference", "action", "actorUid", "actorRole", "toStatus", "createdAtIso"]
    }
  },
  "firestore": {
    "/menu/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Specialty coffee and food catalog items."
    },
    "/billboards/{billboardId}": {
      "schema": { "$ref": "#/entities/BillboardAd" },
      "description": "Promotional image and video ads for the Customer App billboard."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Official customer orders promoted via Stage 04E/04L and tracked in real time."
    },
    "/orderRequests/{requestId}": {
      "schema": { "$ref": "#/entities/OrderRequest" },
      "description": "Customer order requests awaiting Admin verification, authoritative SAR pricing, and promotion or rejection."
    },
    "/orderRequests/{requestId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/OrderRequestAuditLog" },
      "description": "Append-only Admin audit trail records for each order request."
    },
    "/orderNumbers/{orderNumber}": {
      "schema": { "$ref": "#/entities/OrderNumberClaim" },
      "description": "Unique official PM-XXXXXX order number claim registry."
    },
    "/orderRequestAuditLogs/{auditId}": {
      "schema": { "$ref": "#/entities/OrderRequestAuditLog" },
      "description": "Flat append-only cross-app order request audit log collection."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin authorization registry."
    },
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Uploaded menu images and promotional media stored in Firestore."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Dynamic menu categories editable from the admin panel."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CoffeeOptionsSettings" },
      "description": "Store-wide coffee modifier options (coffeeOptions) and optional pricing config (pricing)."
    },
    "/mediaAssets/{assetId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/MediaChunk" },
      "description": "Chunked binary slices for larger promotional videos."
    },
    "/productCustomizations/{productId}": {
      "schema": { "$ref": "#/entities/ProductCustomization" },
      "description": "Stage 04B per-product customization groups, SAR add-on pricing, and special instruction settings."
    }
  }
}
